{
  "manifest_version": 3,
  "name": "Passkey Recovery by sd0x — bridge (preview)",
  "version": "0.1.0",
  "description": "After you click its button on keys.coinbase.com/connect, asks your passkey to sign one request from your local Passkey Recovery page.",
  "key": "",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_title": "Passkey Recovery" },
  "background": { "service_worker": "sw.js", "type": "module" },
  "externally_connectable": { "matches": ["http://127.0.0.1:4173/*"] }
}
