{
  "comment": "Exactly what the public repository contains. A path is exported only when it is listed under include (a file, or a directory exported recursively) and no exclude pattern matches it. Read by scripts/release/export.mjs, which also writes the generated files it lists (.npmrc) — those are never copied from the working copy and must not appear here.",
  "include": [
    ".github",
    ".gitignore",
    ".gitleaks.toml",
    ".nvmrc",
    "404.html",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.md",
    "README.zh-TW.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "docs/INSTALL.md",
    "docs/INSTALL.zh-TW.md",
    "docs/AI_COLLABORATION.md",
    "docs/release",
    "docs/features/open-source-recovery",
    "extension",
    "index.html",
    "licenses",
    "package-lock.json",
    "package.json",
    "playwright.config.mts",
    "registry",
    "scripts/design",
    "scripts/release",
    "server",
    "src",
    "test",
    "tsconfig.json",
    "vite.config.mts",
    "vite.e2e.config.mts",
    "vite.server.config.mts",
    "vitest.integration.config.mts",
    "vitest.live.config.mts",
    "wrangler.jsonc"
  ],
  "exclude": [
    "(^|/)node_modules/",
    "(^|/)\\.DS_Store$",
    "^docs/features/open-source-recovery/requests/",
    "\\.log$",
    "\\.jsonl$",
    "(^|/)\\.env(\\.|$)",
    "\\.(pem|key)$"
  ]
}
